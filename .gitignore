# Build trees from CMake configure/build
**/build/
# Throwaway from-scratch acceptance tree (roadmap task 9.3)
**/build-final/
# JetBrains/CLion CMake trees (cmake-build-debug, cmake-build-release, ...)
**/cmake-build-*/

# Python bytecode caches
__pycache__/

# OS metadata
.DS_Store
Thumbs.db

# PlatformIO build output inside example projects
**/.pio/
# ESP-IDF sdkconfig files PlatformIO generates per environment (sdkconfig.<env>)
examples/*/sdkconfig.*
# Consumer SDK configs are likewise generated per PlatformIO environment.
Modules/tests/Core/consumer/sdkconfig.*
# ...but the shared board profile's sdkconfig.defaults is committed source, not
# generated output, so keep tracking it (the pattern above would eat it).
!examples/esp32-common/sdkconfig.defaults
# Per-site WiFi credentials (committed template: NetworkConfig.example.h)
examples/*/src/NetworkConfig.h
.idea/
# Per-session scratch plans written by the zcode tool
.zcode/
/build-*
# Added by code-review-graph
.code-review-graph/
/.claude/
/.codebuddy/
/.gemini/
/.vscode/
/.qoder/
/.cursor/
/.kiro/