{
  "name": "MicroWorld",
  "version": "0.6.0",
  "description": "MicroWorld: bounded C++17 mini engine for microcontrollers — lifecycle, World/Actor/Component, GC, smart pointers, Messaging, Networking, and byte I/O Transport",
  "keywords": [
    "embedded",
    "engine",
    "lifecycle",
    "tick",
    "memory",
    "allocator",
    "actor",
    "messaging",
    "transport",
    "networking"
  ],
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "includeDir": ".",
    "srcDir": "MicroWorld",
    "libArchive": true,
    "flags": [
      "-fno-exceptions",
      "-fno-rtti"
    ],
    "srcFilter": [
      "+<Core/>",
      "+<Engine/>",
      "+<Messaging/>",
      "+<Networking/>",
      "+<Transport/>",
      "+<Application/>",
      "-<Platform/>"
    ]
  }
}
