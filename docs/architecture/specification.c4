specification {
    // Human role interacting with the product. Never an Actor, never a named person.
    element person {
        style {
            shape person
        }
    }

    // The deliverable and its ownership boundary - the C1 subject.
    element product {
        style {
            shape rectangle
        }
    }

    // Independently executable runtime. A plugin, library or module is not one.
    element application {
        style {
            shape component
        }
    }

    // Major cohesive responsibility owning a contract other code is written against.
    element system {
        style {
            shape rectangle
        }
    }

    // Narrower responsibility owned by a parent, and relative: examined alone, a
    // subsystem is a system.
    element subsystem {
        style {
            shape component
        }
    }

    // Stateful domain concept with identity and a lifecycle. Not a class - one entity
    // may be realised by several objects.
    element entity {
        style {
            shape rectangle
        }
    }

    // Domain behaviour belonging to no single entity. Never a generic manager.
    element domainService {
        style {
            shape component
        }
    }

    // Hardware. The relationship says which sort: 'runs on' a target, 'talks to' a
    // peripheral. Devices nest, so a module sits inside the board carrying it.
    element device {
        style {
            shape mobile
            color slate
        }
    }

    // The element others write code against.
    tag contract

    // Chosen at build time rather than always present.
    tag optional

    // Generic interaction. Use only when no precise relationship applies.
    relationship uses {
        title 'uses'
    }

    // Static architectural dependency, not a particular runtime call.
    relationship dependsOn {
        title 'depends on'
    }

    // Requests an operation that may change state. The target owns validation.
    relationship commands {
        title 'sends commands to'
    }

    // Requests information without intentionally changing state.
    relationship queries {
        title 'queries'
    }

    // Announces a fact that has already happened, expecting no reply.
    relationship publishes {
        title 'publishes to'
        line dotted
    }

    // Synchronises authoritative state to a non-authoritative representation.
    relationship replicates {
        title 'replicates state to'
        line dotted
        color indigo
    }
}
