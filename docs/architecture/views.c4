views {

    // 'index' is reserved: LikeC4 generates its own landing view if no view claims
    // that id, so this one keeps it and carries its level in the title alone.
    view index {
        title '[C1] MicroWorld - System Context'
        description 'Why MicroWorld exists. One application reaching three hardware targets is the point of the product, and the fan-out states it by shape rather than by adjective. Devices exchange messages, not bytes, so the developer never writes link-level code. The UE5 familiarity claim is a property of the API, so it lives in the product description rather than pretending to be a relationship.'
        include developer
        include deviceFirmware
        include microworld
        include esp32Device
        include picoDevice
        include developmentPc
        autoLayout TopBottom
    }

    view c2Systems {
        title '[C2] MicroWorld'
        description 'Six systems, each named for the responsibility it owns and carrying a glyph of what it does. The layout stacks them in dependency order - composition on top, foundation at the bottom - so no colour key is needed for either. Three of these boundaries are decisions rather than groupings, and each answers a question someone will ask again. Engine is one system because Object owns identity and Engine owns the lifetime built on it, and neither is a responsibility anything wants alone. Transport holds every medium because a named one - Wi-Fi, a wire, a radio - only satisfies the driver contract and declares nothing outward, which makes it an implementation. And Engine and Transport have no edge between them, nor does any system join them: that total absence is the most important rule in the model, and the play-system turn points in Core are what let a service extend a loop it cannot see. Messaging System sits beside them on Core rather than between them, with two ways in - one through Application alone, one through Networking - because local actor messaging needs neither Networking nor Transport. Messaging System and Networking are both IPlaySystem implementations a composition root installs, and neither depends on Engine. Every dependency label names what actually crosses it.'
        include microworld
        include microworld.core
        include microworld.engine
        include microworld.messagingSystem
        include microworld.transport
        include microworld.app
        include microworld.networking
        autoLayout TopBottom
    }

    view c3Engine of microworld.engine {
        title '[C3] Engine'
        description 'C3, because the deferred spawn barrier and generation-checked handles are the two things a new contributor reliably gets wrong. The identity-versus-lifetime split is deliberately not repeated on these seven children - it is a C2 fact and the C2 subtitle carries it.'
        include *
        autoLayout TopBottom
    }

    view c3Transport of microworld.transport {
        title '[C3] Transport'
        description 'One interface and every family that realises it. Drivers appear by family rather than one box per class, because an eighth box saying it realises INetDriver teaches nothing the third did not - the class names are in the subtitles. Each family carries an icon of its physical medium, which is the only thing the three differ by; the elements without one are the always-present machinery.'
        include *
        autoLayout TopBottom
    }

}
