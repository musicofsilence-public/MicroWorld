model {
    developer = person 'Firmware Developer' {
        technology '[person: engineer]'
        description 'Composes and ships device firmware.'
    }

    // Only one, deliberately: a remote node runs this same application, so a second
    // 'peer' element would model one fact twice.
    deviceFirmware = application 'Device Firmware' {
        technology '[application: C++17 firmware]'
        description 'Same source, no per-target changes.'
    }

    esp32Device = device 'ESP32-S3' {
        technology '[device: microcontroller]'
        description 'Wi-Fi and radio, on ESP-IDF.'
    }

    // RP2040 is literally Raspberry Pi silicon. The set has no espressif or
    // generic-MCU glyph, so ESP32-S3 stays bare rather than borrow a wrong one.
    picoDevice = device 'RP2040' {
        technology '[device: microcontroller]'
        description 'Radio only, on the Pico SDK.'
        style {
            icon tech:raspberry-pi
        }
    }

    developmentPc = device 'Development PC' {
        technology '[device: development host]'
        description 'Host tests, on OS sockets.'
        style {
            shape browser
        }
    }

    // Outside the product boundary, which is the point: position states that we do not
    // own these, and every medium reaches out to one rather than implementing a radio.
    espIdf = system 'ESP-IDF' {
        technology '[system: platform implementation]'
        description 'Espressif Wi-Fi, Bluetooth and buses.'
        style {
            color slate
        }
    }

    picoSdk = system 'Pico SDK' {
        technology '[system: platform implementation]'
        description 'RP2040 serial ports and timers.'
        style {
            color slate
        }
    }

    hostOs = system 'Host OS' {
        technology '[system: platform implementation]'
        description 'Desktop sockets and a steady clock.'
        style {
            color slate
        }
    }

    microworld = product 'MicroWorld' {
        technology '[product: C++17 static library]'
        description 'UE5 worlds, actors and lifecycle on microcontrollers.'
        style {
            color muted
            icon tech:cplusplus
        }

        core = system 'Core' {
            technology '[system: foundation]'
            description 'Sequences work and exposes extension interfaces.'
            style {
                icon ./icon-core.svg
            }
            metadata {
                contract 'time, tick scheduling, timers, logging, lifecycle, result codes, the play-system turn points, byte streams'
            }
        }

        engine = system 'Engine' {
            technology '[system: managed runtime]'
            description 'Owns object identity and actor lifetime.'
            style {
                icon ./icon-engine.svg
            }
            metadata {
                contract 'IEngine, UWorld, AActor, UActorComponent, FObjectStore'
                boundary 'Object owns identity, Engine owns the lifetime built on it. Neither is a responsibility anything wants alone, so they are one system'
            }

            engineInterface = interface 'Engine Interface' {
                technology '[interface: IEngine / TEngine<TTraits>]'
                description 'Narrow interface the application holds.'
                style {
                    icon ./icon-interface.svg
                }
            }

            world = entity 'World' {
                technology '[entity: UWorld]'
                description 'Owns registered and spawned actors.'
            }

            actor = entity 'Actor' {
                technology '[entity: AActor]'
                description 'Ticking participant with a lifecycle.'
            }

            actorComponent = entity 'Actor Component' {
                technology '[entity: UActorComponent]'
                description 'Reusable behaviour attached to an actor.'
            }

            spawnBarrier = component 'Deferred Spawn Barrier' {
                technology '[component: queued actor factories]'
                description 'Constructs actors only at safe points.'
            }

            objectStore = component 'Object Store' {
                technology '[component: FObjectStore, generation-checked handles]'
                description 'Resolves handles and detects stale ones.'
                style {
                    shape storage
                    icon none
                }
            }

            collector = component 'Garbage Collector' {
                technology '[component: FGarbageCollector]'
                description 'Reclaims unreachable managed objects.'
            }
        }

        messagingSystem = system 'Messaging System' {
            technology '[system: play service]'
            description 'Delivers typed messages between actors, with or without a transport.'
            style {
                shape queue
                icon ./icon-messaging.svg
            }
            metadata {
                contract 'TMessageRouter (an IPlaySystem), channel bindings, and the delivery mode a binding declares'
                standalone 'Usable with no networking at all. Its contract names neither actors nor transports, so Core plus this system is already a working stack, and Core + Engine + this is local actor messaging with no Transport, no Networking and no device. A binding may still declare reliable delivery there - locally the call itself satisfies it, which is why declaring a mode drags in no machinery'
                boundary 'That independence is the whole reason it is its own system. Folding it into Networking would assert that a message between two actors on one board travels through networking, which is false'
            }
        }

        transport = system 'Transport' {
            technology '[system: byte I/O]'
            description 'Moves bytes over any medium, reporting acceptance not delivery.'
            style {
                icon ./icon-transport.svg
            }
            metadata {
                contract 'one device shape - Setup, SendDataTo, OnDataReceived - realised once per medium, plus wire framing for the stream media'
                boundary 'Transport sits below the engine and takes only time and result codes. Anything that merely realises the device shape belongs inside it - Wi-Fi, Bluetooth, wire and radio alike - and anything needing a world cannot be in here at all'
                standalone 'It reports acceptance, never delivery, so no medium here sequences, acknowledges or retries. Reading an acknowledgement would mean opening the payload this system promised to carry opaquely'
            }

            deviceInterface = interface 'Device Interface' {
                technology '[interface: Setup, SendDataTo, OnDataReceived]'
                description 'Configures, sends without blocking, drains arrivals each turn.'
                style {
                    icon ./icon-interface.svg
                }
                metadata {
                    boundary 'The application holds a medium device directly, so this contract is both what an application writes against and what each medium realises. There is no layer above it to hide the choice of medium, because choosing the medium is the point. Whoever owns a device installs it - an application holding one pumps it in its own frame loop, Networking pumps the ones it owns, and never both for the same device'
                    contract 'The three operations plus the four play-system turns, because a callback cannot fire itself. Setup answers with a Core result code, and a device before Setup is unusable. The span handed to a subscriber belongs to the device and is valid only for that call. A device publishes the largest payload it can take and refuses anything longer instead of splitting. A broadcast address is a value of the same shape rather than a second operation, refused by a medium that cannot reach it'
                    standalone 'Uniform in its data path, deliberately not in Setup: one address shape lets SendDataTo read the same on every medium, while configuration stays per-medium because an SSID and a baud rate have nothing in common. That asymmetry is why an application names a concrete device type to configure it and needs nothing concrete afterwards. What is uniform is the shape, not the meaning - each medium reads the address its own way, and a point-to-point one ignores it entirely'
                }
            }

            frameCodec = component 'Frame Codec' {
                technology '[component: magic, length and CRC framing]'
                description 'Recovers message boundaries from a byte stream.'
            }

            wifiDevice = component 'Wi-Fi Device' {
                #optional
                technology '[component: UDP datagrams]'
                description 'Carries data over Wi-Fi and desktop sockets.'
                style {
                    icon ./icon-ip.svg
                }
                metadata {
                    boundary 'One element, two platforms. The same UDP shape serves a board and a development host, so the difference belongs on the arrows below it rather than in a second box'
                }
            }

            bluetoothDevice = component 'Bluetooth Device' {
                #optional
                technology '[component: paired-link datagrams]'
                description 'Carries data over Bluetooth to one peer.'
                style {
                    icon ./icon-bluetooth.svg
                }
            }

            loraDevice = component 'LoRa Device' {
                #optional
                technology '[component: E32 on a byte stream]'
                description 'Carries data over long-range radio.'
                style {
                    icon ./icon-radio.svg
                }
                metadata {
                    boundary 'The only medium whose protocol is portable. Platform ownership stops at the byte stream underneath it, which is why one E32 implementation serves every board'
                }
            }

            wiredDevice = component 'Wired Device' {
                #optional
                technology '[component: UART, I2C, SPI]'
                description 'Carries data board-to-board over a bus.'
                style {
                    icon ./icon-wired.svg
                }
                metadata {
                    boundary 'One element for three buses. UART, I2C and SPI differ in wiring, in who clocks the line, and in how a peer is named - I2C takes one per send, SPI selects one at Setup with a chip-select line, UART has only the one it is wired to. None of that changes the shape, and all three must frame'
                }
            }
        }

        app = system 'Application' {
            technology '[system: composition root]'
            description 'Starts, drives and stops one engine.'
            style {
                icon ./icon-application.svg
            }
            metadata {
                contract 'FApplication, Run frame loop'
            }
        }

        networking = system 'Networking' {
            technology '[system: play service]'
            description 'Gives this node a role and binds channels to wires.'
            style {
                icon ./icon-networking.svg
            }
            metadata {
                contract 'TNetworking, an IPlaySystem that owns devices and channels and drives them in the order a frame requires'
                standalone 'Core, Messaging and Transport are its whole closure, so a networked messaging stack needs no world, no actors and no Object. It cannot drive itself though - something must call its turn points each frame'
                boundary 'Merged with Transport, one element would own both the byte contract and the message types, and nothing would then forbid a device from knowing a message type. Kept apart, a device stays reusable with no messaging, messaging stays usable with no device, and adding a transport touches neither. A separation needs two elements to state it. Role is what makes this a system rather than a composition root: a client addresses the server, a server addresses all peers, and that follows from the role this node plays. Messaging cannot hold role without learning that wires exist, and Transport cannot hold it without learning that channels do. If that invariant ever moves elsewhere, what remains here is wiring and should be deleted'
            }
        }
    }


    developer -[uses]-> microworld 'writes one application with'

    // Direction is deliberate: a static library is compiled INTO the executable.
    // Reversing it lies, and strands the product beside the hardware in TopBottom.
    microworld -[uses]-> deviceFirmware 'compiles into'

    deviceFirmware -[uses]-> esp32Device 'runs on'
    deviceFirmware -[uses]-> picoDevice 'runs on'
    deviceFirmware -[uses]-> developmentPc 'runs on'

    esp32Device -[uses]-> picoDevice 'exchanges messages with'


    microworld.engine -[dependsOn]-> microworld.core 'takes Time, Timer, Lifecycle, PlaySystem'

    microworld.messagingSystem -[dependsOn]-> microworld.core 'takes Span, Delegate, Time, PlaySystem'

    microworld.transport -[dependsOn]-> microworld.core 'takes Span, Delegate, Log, Time, PlaySystem, UartByteStream'

    microworld.networking -[dependsOn]-> microworld.core 'takes PlaySystem'

    microworld.app -[dependsOn]-> microworld.core 'takes Lifecycle, RuntimeResult, Time'

    microworld.app -[dependsOn]-> microworld.engine 'holds one engine for its lifetime'

    // 'uses' not 'dependsOn': Application runs whatever play system it is handed, so it
    // is not written against either of these in particular.
    microworld.app -[uses]-> microworld.messagingSystem 'installs the router in its frame loop, no transport involved'

    microworld.app -[uses]-> microworld.transport 'installs a device it was handed and pumps it each frame'

    microworld.networking -[dependsOn]-> microworld.messagingSystem 'routes typed messages through'

    microworld.networking -[uses]-> microworld.transport 'pumps the devices it owns each frame'


    microworld.engine.engineInterface -[uses]-> microworld.engine.world 'owns and advances'
    microworld.engine.engineInterface -[dependsOn]-> microworld.engine.objectStore 'resolves handles through'
    microworld.engine.objectStore -[dependsOn]-> microworld.core 'takes Time'
    microworld.engine.world -[uses]-> microworld.engine.spawnBarrier 'queues spawns through'
    microworld.engine.spawnBarrier -[uses]-> microworld.engine.actor 'constructs'
    microworld.engine.actor -[uses]-> microworld.engine.actorComponent 'owns'
    microworld.engine.collector -[uses]-> microworld.engine.objectStore 'reclaims through'

    microworld.transport.deviceInterface -[realisedBy]-> microworld.transport.wifiDevice
    microworld.transport.deviceInterface -[realisedBy]-> microworld.transport.bluetoothDevice
    microworld.transport.deviceInterface -[realisedBy]-> microworld.transport.loraDevice
    microworld.transport.deviceInterface -[realisedBy]-> microworld.transport.wiredDevice

    microworld.transport.loraDevice -[uses]-> microworld.transport.frameCodec 'recovers message boundaries with'
    microworld.transport.wiredDevice -[uses]-> microworld.transport.frameCodec 'recovers message boundaries with'


    microworld.core -[dependsOn]-> espIdf 'Time and Log realised by'
    microworld.core -[dependsOn]-> hostOs 'Time realised by'

    // 'realised by' for three media, 'takes a byte stream from' for one: LoRa is the
    // only medium whose protocol we own, so its platform dependency stops at the wire.
    microworld.transport.wifiDevice -[dependsOn]-> espIdf 'realised by'
    microworld.transport.wifiDevice -[dependsOn]-> hostOs 'realised by'
    microworld.transport.bluetoothDevice -[dependsOn]-> espIdf 'realised by'
    microworld.transport.wiredDevice -[dependsOn]-> espIdf 'realised by'

    microworld.transport.loraDevice -[dependsOn]-> espIdf 'takes a byte stream from'
    microworld.transport.loraDevice -[dependsOn]-> picoSdk 'takes a byte stream from'
}
