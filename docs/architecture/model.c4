model {
    developer = person 'Firmware Developer' {
        technology '[person: engineer]'
        description 'Composes and ships device firmware.'
    }

    // Only one, deliberately: a remote node runs this same application, so a second
    // 'peer' element would model one fact twice.
    deviceFirmware = application 'Device Firmware' {
        technology '[application: C++17 firmware]'
        description 'Same source, no per-target changes.'
    }

    esp32Device = device 'ESP32-S3' {
        technology '[device: microcontroller]'
        description 'Wi-Fi and radio, on ESP-IDF.'
    }

    // RP2040 is literally Raspberry Pi silicon. The set has no espressif or
    // generic-MCU glyph, so ESP32-S3 stays bare rather than borrow a wrong one.
    picoDevice = device 'RP2040' {
        technology '[device: microcontroller]'
        description 'Radio only, on the Pico SDK.'
        style {
            icon tech:raspberry-pi
        }
    }

    developmentPc = device 'Development PC' {
        technology '[device: development host]'
        description 'Host tests, on OS sockets.'
        style {
            shape browser
        }
    }

    microworld = product 'MicroWorld' {
        technology '[product: C++17 static library]'
        description 'UE5 worlds, actors and lifecycle on microcontrollers.'
        style {
            color muted
            icon tech:cplusplus
        }

        core = system 'Core' {
            technology '[system: foundation]'
            description 'Sequences work and exposes extension interfaces.'
            style {
                icon ./icon-core.svg
            }
            metadata {
                contract 'time, tick scheduling, timers, logging, lifecycle, result codes, the play-system turn points, byte streams'
                traceability 'Modules/MicroWorld/Core headers: Time.h, TickFunction.h, Timer.h, Log.h, Lifecycle.h, PlaySystem.h, IO/UartByteStream.h'
            }
        }

        engine = system 'Engine' {
            technology '[system: managed runtime]'
            description 'Owns object identity and actor lifetime.'
            style {
                icon ./icon-engine.svg
            }
            metadata {
                contract 'IEngine, UWorld, AActor, UActorComponent, FObjectStore'
                boundary 'Object owns identity, Engine owns the lifetime built on it. Neither is a responsibility anything wants alone, so they are one system'
                traceability 'Modules/MicroWorld/Engine (Engine + folded Object)'
            }

            engineFrontDoor = subsystem 'Engine Front Door' {
                #contract
                technology '[subsystem: IEngine / TEngine<TTraits>]'
                description 'Narrow interface the application holds.'
                metadata {
                    traceability 'Modules/MicroWorld/Engine/EngineHost.h'
                }
            }

            world = entity 'World' {
                technology '[entity: UWorld]'
                description 'Owns registered and spawned actors.'
                metadata {
                    traceability 'Modules/MicroWorld/Engine/World.h'
                }
            }

            actor = entity 'Actor' {
                technology '[entity: AActor]'
                description 'Ticking participant with a lifecycle.'
                metadata {
                    traceability 'Modules/MicroWorld/Engine/Actor.h'
                }
            }

            actorComponent = entity 'Actor Component' {
                technology '[entity: UActorComponent]'
                description 'Reusable behaviour attached to an actor.'
                metadata {
                    traceability 'Modules/MicroWorld/Engine/ActorComponent.h'
                }
            }

            spawnBarrier = domainService 'Deferred Spawn Barrier' {
                technology '[domainService: queued actor factories]'
                description 'Constructs actors only at safe points.'
                metadata {
                    traceability 'Modules/MicroWorld/Engine/DeferredActorSpawn.h'
                }
            }

            objectStore = subsystem 'Object Store' {
                technology '[subsystem: FObjectStore, generation-checked handles]'
                description 'Resolves handles and detects stale ones.'
                style {
                    shape storage
                }
                metadata {
                    traceability 'Modules/MicroWorld/Engine/ObjectStore.h'
                }
            }

            collector = domainService 'Garbage Collector' {
                technology '[domainService: FGarbageCollector]'
                description 'Reclaims unreachable managed objects.'
                metadata {
                    traceability 'Modules/MicroWorld/Engine/GarbageCollector.h'
                }
            }
        }

        messagingSystem = system 'Messaging System' {
            technology '[system: play service]'
            description 'Delivers typed messages between actors, with or without a transport.'
            style {
                shape queue
                icon ./icon-messaging.svg
            }
            metadata {
                contract 'TMessageRouter (an IPlaySystem), channel bindings, reliable channel'
                standalone 'Usable with no networking at all. Its contract names neither actors nor transports, so Core plus this system is already a working stack, and Core + Engine + this is local actor messaging with no Transport, no Networking and no driver'
                boundary 'That independence is the whole reason it is its own system. Folding it into Networking would assert that a message between two actors on one board travels through networking, which is false'
                traceability 'Modules/MicroWorld/Messaging; examples/22-ActorMessages is that program. TMessageRouter includes only Message.h, PlaySystem.h and Time.h - confirmation the code currently honours the decision, never the reason for it'
            }
        }

        transport = system 'Transport' {
            technology '[system: byte I/O]'
            description 'Moves framed bytes over any medium.'
            style {
                icon ./icon-transport.svg
            }
            metadata {
                contract 'INetDriver, TNetHost, frame codec, protocol'
                boundary 'Transport sits below the engine and takes only time and result codes. Anything that merely satisfies the driver contract belongs inside it - IP, wire and radio alike - and anything needing a world cannot be in here at all'
                traceability 'Modules/MicroWorld/Transport (Net + RadioE32)'
            }

            driverContract = subsystem 'Driver Contract' {
                #contract
                technology '[subsystem: INetDriver]'
                description 'Send, receive and advance one transport.'
                metadata {
                    traceability 'Modules/MicroWorld/Transport/NetDriver.h'
                }
            }

            transportHost = subsystem 'Transport Host' {
                technology '[subsystem: TNetHost]'
                description 'Drives one driver every frame.'
                metadata {
                    traceability 'Modules/MicroWorld/Transport/NetHost.h'
                }
            }

            frameCodec = domainService 'Frame Codec' {
                technology '[domainService: magic, length and CRC framing]'
                description 'Frames and resynchronises byte streams.'
                metadata {
                    traceability 'Modules/MicroWorld/Transport/FrameCodec.h'
                }
            }

            ipDrivers = subsystem 'IP Drivers' {
                #optional
                technology '[subsystem: FHostUdpDriver, FEsp32UdpDriver]'
                description 'Carries frames over desktop sockets and device Wi-Fi.'
                style {
                    icon ./icon-ip.svg
                }
                metadata {
                    traceability 'Modules/MicroWorld/Platform/Host/HostUdpDriver.cpp; Modules/MicroWorld/Platform/Esp32/Esp32UdpDriver.h'
                }
            }

            wiredDrivers = subsystem 'Wired Drivers' {
                #optional
                technology '[subsystem: FEsp32Uart, FEsp32I2cMaster/Slave, FEsp32Spi drivers]'
                description 'Carries frames board-to-board over UART, I2C or SPI.'
                style {
                    icon ./icon-wired.svg
                }
                metadata {
                    traceability 'Modules/MicroWorld/Platform/Esp32/Esp32UartDriver.h, Esp32I2cDriver.h, Esp32SpiDriver.h'
                }
            }

            radioDrivers = subsystem 'Radio Drivers' {
                #optional
                technology '[subsystem: FRadioE32Driver over IUartByteStream]'
                description 'Carries frames over long-range radio. The E32 protocol is portable; only UART ownership is per-platform.'
                style {
                    icon ./icon-radio.svg
                }
                metadata {
                    traceability 'Modules/MicroWorld/Transport/RadioE32Driver.h; ESP-IDF and Pico UART facades in Modules/MicroWorld/Platform/Esp32, Modules/MicroWorld/Platform/Pico'
                }
            }
        }

        app = system 'Application' {
            technology '[system: composition root]'
            description 'Starts, drives and stops one engine.'
            style {
                icon ./icon-application.svg
            }
            metadata {
                contract 'FApplication, Run frame loop'
                traceability 'Modules/MicroWorld/Application'
            }
        }

        networking = system 'Networking' {
            technology '[system: play service]'
            description 'Carries typed messages over a transport.'
            style {
                icon ./icon-networking.svg
            }
            metadata {
                contract 'TNetSystem, an IPlaySystem that owns net drivers and channels'
                standalone 'Core, Messaging and Transport are its whole closure, so a networked messaging stack needs no world, no actors and no Object. It cannot drive itself though - something must call its turn points each frame'
                boundary 'Merged with Transport, one element would own both the byte contract and the message types, and nothing would then forbid a driver from knowing a message type. Kept apart, a driver stays reusable with no messaging, messaging stays usable with no driver, and adding a transport touches neither. A separation needs two elements to state it'
                traceability 'Modules/MicroWorld/Networking'
            }
        }
    }


    developer -[uses]-> microworld 'writes one application with'

    // Direction is deliberate: a static library is compiled INTO the executable.
    // Reversing it lies, and strands the product beside the hardware in TopBottom.
    microworld -[uses]-> deviceFirmware 'compiles into'

    deviceFirmware -[uses]-> esp32Device 'runs on'
    deviceFirmware -[uses]-> picoDevice 'runs on'
    deviceFirmware -[uses]-> developmentPc 'runs on'

    esp32Device -[uses]-> picoDevice 'exchanges messages with' {
        metadata {
            traceability 'examples/26-MessagingOverLora over E32 radio; Modules/MicroWorld/Messaging router'
        }
    }


    microworld.engine -[dependsOn]-> microworld.core 'takes Time, Timer, Lifecycle, PlaySystem' {
        metadata {
            traceability 'MicroWorld/Engine/EngineHost.h, MicroWorld/Engine/Actor.h includes'
        }
    }

    microworld.messagingSystem -[dependsOn]-> microworld.core 'takes Span, Delegate, Time, PlaySystem' {
        metadata {
            traceability 'MicroWorld/Messaging/MessageRouter.h, MicroWorld/Messaging/Message.h includes'
        }
    }

    microworld.transport -[dependsOn]-> microworld.core 'takes Span, Delegate, Log, Time, UartByteStream' {
        metadata {
            traceability 'MicroWorld/Transport/NetHost.h and MicroWorld/Transport/RadioE32Driver.h includes'
        }
    }

    microworld.networking -[dependsOn]-> microworld.core 'takes PlaySystem' {
        metadata {
            traceability 'MicroWorld/Networking/NetSystem.h; IPlaySystem is MicroWorld/Core/PlaySystem.h, still reached today via MicroWorld/Engine/EngineSystem.h'
        }
    }

    microworld.app -[dependsOn]-> microworld.core 'takes Lifecycle, RuntimeResult, Time' {
        metadata {
            traceability 'MicroWorld/Application/Application.h includes'
        }
    }

    microworld.app -[dependsOn]-> microworld.engine 'holds one engine for its lifetime' {
        metadata {
            traceability 'MicroWorld/Application/Application.h'
        }
    }

    // 'uses' not 'dependsOn': Application runs whatever engine system it is handed,
    // so it is not written against this one in particular.
    microworld.app -[uses]-> microworld.messagingSystem 'installs the router in its frame loop, no transport involved' {
        metadata {
            traceability 'examples/22-ActorMessages/src/Main.cpp composes Engine and Messaging with no Transport'
        }
    }

    microworld.networking -[dependsOn]-> microworld.messagingSystem 'routes typed messages through' {
        metadata {
            traceability 'MicroWorld/Networking/NetSystem.h'
        }
    }

    microworld.networking -[uses]-> microworld.transport 'pumps the transport host each frame' {
        metadata {
            traceability 'MicroWorld/Networking/NetSystem.h'
        }
    }


    microworld.engine.engineFrontDoor -[uses]-> microworld.engine.world 'owns and advances'
    microworld.engine.engineFrontDoor -[dependsOn]-> microworld.engine.objectStore 'resolves handles through' {
        metadata {
            traceability 'Engine/EngineHost.h over Object/ObjectStore.h'
        }
    }
    microworld.engine.objectStore -[dependsOn]-> microworld.core 'takes Time' {
        metadata {
            traceability 'Object/GarbageCollector.h includes'
        }
    }
    microworld.engine.world -[uses]-> microworld.engine.spawnBarrier 'queues spawns through'
    microworld.engine.spawnBarrier -[uses]-> microworld.engine.actor 'constructs'
    microworld.engine.actor -[uses]-> microworld.engine.actorComponent 'owns'
    microworld.engine.collector -[uses]-> microworld.engine.objectStore 'reclaims through'

    microworld.transport.transportHost -[uses]-> microworld.transport.driverContract 'drives one'
    microworld.transport.transportHost -[uses]-> microworld.transport.frameCodec 'frames through'
    microworld.transport.ipDrivers -[uses]-> microworld.transport.driverContract 'realises'
    microworld.transport.wiredDrivers -[uses]-> microworld.transport.driverContract 'realises'
    microworld.transport.radioDrivers -[uses]-> microworld.transport.driverContract 'realises'
}
