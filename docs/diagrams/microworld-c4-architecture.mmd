title: MicroWorld Architecture — C4 Container View
---
%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "curve": "basis", "nodeSpacing": 48, "rankSpacing": 64}}}%%
flowchart TB
    DEV["<b>UE5 / Embedded Developer</b><br/><small>Builds bounded MCU applications</small>"]

    subgraph DEVICE["Microcontroller Application"]
        direction TB
        APP["<b>Application</b><br/><small>[Application]<br/>Owns composition, time, and concrete devices</small>"]

        subgraph MW["MicroWorld Portable Runtime — C++17"]
            direction LR
            CORE["<b>Core</b><br/><small>[Foundation]<br/>Time · lifecycle · fixed containers<br/>IPlaySystem · ITransportDevice</small>"]
            MSG["<b>Messaging</b><br/><small>[System]<br/>Links · routes · channels<br/>codecs · reliable delivery</small>"]
            NET["<b>Networking</b><br/><small>[System]<br/>Client/Server sessions · peers<br/>liveness · routed delivery</small>"]
            ENGINE["<b>Engine</b><br/><small>[System]<br/>World · Actors · Components<br/>Object store · GC · optional Network</small>"]
            TRANSPORT["<b>Transport</b><br/><small>[System]<br/>Byte I/O · frame codec<br/>portable E32 transport</small>"]

            MSG -->|"uses Core route/device contracts"| CORE
            NET -->|"uses channels and explicit routes"| MSG
            NET -->|"uses time and lifecycle"| CORE
            ENGINE -->|"owns optional Messaging and Networking"| NET
            ENGINE -->|"uses runtime primitives"| CORE
            TRANSPORT -->|"realises byte-device contract"| CORE
        end

        DEVICES["<b>Concrete Devices</b><br/><small>[Application-owned]<br/>UDP · UART · E32</small>"]
        APP -->|"creates and advances once"| DEVICES
        APP -->|"configures"| ENGINE
        DEVICES -. "registered with Messaging" .-> MSG
    end

    SDK["<b>Platform SDK / HAL</b><br/><small>[External]<br/>ESP-IDF · Pico SDK · host OS</small>"]
    MCU["<b>Microcontroller Hardware</b><br/><small>[External]<br/>ESP32 · RP2040 · similar MCUs</small>"]

    DEV -->|"develops"| APP
    DEVICES -->|"calls"| SDK
    SDK -->|"controls"| MCU

